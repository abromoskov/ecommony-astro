
---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/ecommony.css';
const {
  title,
  description,
  eyebrow = '',
} = Astro.props;

const siteUrl = 'https://ecommony.com';
const seoTitle = title.includes('Ecommony') ? title : `${title} | Ecommony`;
const seoCanonical = `${siteUrl}${Astro.url.pathname}`;
---

<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    

    <title>{seoTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={seoCanonical} />
    <meta name="robots" content="index,follow" />

    <meta property="og:title" content={seoTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={seoCanonical} />
    <meta property="og:site_name" content="Ecommony" />

   
  </head>

  <body>
    <div class="wrap">
      <SiteHeader />

      <slot />

      <SiteFooter />
    </div>
    <!-- Google tag (gtag.js) — delayed until idle to protect first paint -->
  <link rel="preconnect" href="https://www.googletagmanager.com">
  <link rel="dns-prefetch" href="//www.googletagmanager.com">

  <script>
    window.dataLayer = window.dataLayer || [];
    window.gtag = function(){ window.dataLayer.push(arguments); };

    function loadEcommonyGA4(){
      if (window.__ecommonyGA4Loaded) return;
      window.__ecommonyGA4Loaded = true;

      const script = document.createElement('script');
      script.async = true;
      script.src = 'https://www.googletagmanager.com/gtag/js?id=G-BFJDYQHSPM';
      document.head.appendChild(script);

      window.gtag('js', new Date());
      window.gtag('config', 'G-BFJDYQHSPM');
    }

    if ('requestIdleCallback' in window) {
      window.requestIdleCallback(loadEcommonyGA4, { timeout: 3000 });
    } else {
      window.addEventListener('load', function(){
        window.setTimeout(loadEcommonyGA4, 1000);
      });
    }
  </script>
  <script defer src="https://cdn.kiprotect.com/klaro/v0.7/klaro.min.js"></script>
  </body>
</html>