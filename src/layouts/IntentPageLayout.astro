---
const {
  title,
  description,
  eyebrow = '',
} = Astro.props;

const siteUrl = 'https://ecommony.com';
const seoTitle = title.includes('Ecommony') ? title : `${title} | Ecommony`;
const seoCanonical = `${siteUrl}${Astro.url.pathname}`;
---

<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <script async src="https://www.googletagmanager.com/gtag/js?id=G-BFJDYQHSPM"></script>
    <!-- Google tag (gtag.js) -->
    <script>
      window.dataLayer = window.dataLayer || [];
      window.gtag = function(){window.dataLayer.push(arguments);}
      window.gtag('js', new Date());
      window.gtag('config', 'G-BFJDYQHSPM');
    </script>

    <title>{seoTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={seoCanonical} />
    <meta name="robots" content="index,follow" />

    <meta property="og:title" content={seoTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={seoCanonical} />
    <meta property="og:site_name" content="Ecommony" />

    <style is:global>
      :root{
        --bg:#f5f1ea;
        --text:#101826;
        --muted:#5f6775;
        --muted2:#7b8494;
        --line:rgba(16,24,38,.10);
        --brand:#c58a2d;
        --accent:#1b2b44;
        --shadow:0 16px 44px rgba(11,18,32,.10);
        --shadow2:0 10px 28px rgba(11,18,32,.08);
        --radius:18px;
        --max:1120px;
      }

      *{box-sizing:border-box}

      html{scroll-behavior:smooth}

      body{
        margin:0;
        font-family:ui-sans-serif,system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial,"Apple Color Emoji","Segoe UI Emoji";
        color:var(--text);
        background:var(--bg);
        line-height:1.65;
      }

      body::before{
        content:"";
        position:fixed;
        inset:0;
        pointer-events:none;
        z-index:-1;
        background:
          radial-gradient(1100px 700px at 10% 0%, rgba(197,138,45,.10), transparent 64%),
          radial-gradient(900px 620px at 90% 8%, rgba(27,43,68,.10), transparent 62%),
          radial-gradient(1000px 700px at 50% 100%, rgba(197,138,45,.05), transparent 68%),
          linear-gradient(180deg,#f7f3ec 0%,#f3eee7 100%);
        background-repeat:no-repeat;
      }

      a{color:inherit;text-decoration:none}

      .wrap{
        max-width:var(--max);
        margin:0 auto;
        padding:24px;
      }

      .nav{
        display:flex;
        align-items:center;
        justify-content:space-between;
        gap:16px;
        padding:14px 0 22px;
      }

      .logo{
        display:flex;
        gap:10px;
        align-items:center;
        font-weight:800;
        letter-spacing:.2px;
      }

      .mark{
        width:34px;
        height:34px;
        display:inline-flex;
        align-items:center;
        justify-content:center;
        flex:0 0 auto;
      }

      .mark img{
        width:100%;
        height:100%;
        object-fit:contain;
      }

      .navlinks{
        display:flex;
        gap:10px;
        align-items:center;
        flex-wrap:wrap;
      }

      .navlinks a{
        padding:10px 12px;
        border-radius:12px;
        color:var(--muted);
      }

      .navlinks a:hover{
        background:rgba(11,18,32,.04);
        color:var(--text);
      }

      .mobile-menu{
        display:none;
      }

      .mobile-menu summary{
        list-style:none;
      }

      .mobile-menu summary::-webkit-details-marker{
        display:none;
      }

      .mobile-menu__panel{
        position:absolute;
        right:24px;
        top:78px;
        z-index:20;
        display:grid;
        gap:8px;
        min-width:220px;
        padding:12px;
        border:1px solid var(--line);
        border-radius:16px;
        background:rgba(255,255,255,.96);
        box-shadow:var(--shadow);
      }

      .mobile-menu__panel a{
        padding:10px 12px;
        border-radius:12px;
        color:var(--muted);
        font-weight:700;
      }

      .mobile-menu__panel a:hover{
        background:rgba(11,18,32,.04);
        color:var(--text);
      }

      .btn{
        display:inline-flex;
        align-items:center;
        justify-content:center;
        gap:10px;
        padding:12px 16px;
        border-radius:14px;
        border:1px solid var(--line);
        background:#fff;
        color:var(--text);
        box-shadow:var(--shadow2);
        cursor:pointer;
        font-weight:700;
      }

      .btn.primary{
        background:linear-gradient(135deg,var(--brand),var(--accent));
        border-color:transparent;
        color:#fff;
        box-shadow:0 20px 48px rgba(197,138,45,.22);
      }

      .breadcrumb{
        display:flex;
        flex-wrap:wrap;
        gap:8px;
        align-items:center;
        margin:8px 0 18px;
        color:var(--muted2);
        font-size:14px;
      }

      .breadcrumb a{
        color:var(--muted);
      }

      .breadcrumb a:hover{
        color:var(--text);
      }

      .intent-hero{
        padding:18px 0 28px;
        max-width:900px;
      }

      .pill{
        display:inline-flex;
        align-items:center;
        gap:10px;
        padding:8px 12px;
        border:1px solid var(--line);
        border-radius:999px;
        background:rgba(255,255,255,.78);
        color:var(--muted);
        font-size:13px;
        box-shadow:var(--shadow2);
      }

      h1{
        margin:16px 0 12px;
        font-size:clamp(38px,4.6vw,62px);
        line-height:1.04;
        letter-spacing:-1.2px;
        max-width:15ch;
      }

      .sub{
        font-size:clamp(17px,1.8vw,21px);
        color:var(--muted);
        max-width:68ch;
        margin:0;
      }

      .intent-grid{
        display:grid;
        grid-template-columns:1.55fr .85fr;
        gap:22px;
        align-items:start;
      }

      .content-card,
      .side-card{
        background:rgba(255,255,255,.90);
        border:1px solid var(--line);
        border-radius:var(--radius);
        box-shadow:var(--shadow);
        padding:24px;
      }

      .content-card{
        display:grid;
        gap:22px;
      }

      .section-block h2{
        margin:0 0 10px;
        font-size:clamp(25px,2.6vw,34px);
        line-height:1.12;
        letter-spacing:-.5px;
      }

      .section-block p{
        margin:0;
        color:var(--muted);
        font-size:18px;
      }

      .check-list{
        margin:12px 0 0;
        padding:0;
        list-style:none;
        display:grid;
        gap:10px;
      }

      .check-list li{
        padding:14px 14px 14px 42px;
        border:1px solid var(--line);
        border-radius:14px;
        background:#fff;
        color:var(--text);
        position:relative;
      }

      .check-list li::before{
        content:"";
        width:10px;
        height:10px;
        border-radius:999px;
        background:linear-gradient(135deg,var(--brand),var(--accent));
        position:absolute;
        left:17px;
        top:23px;
      }

      .side-card{
        position:sticky;
        top:18px;
      }

      .side-card h2{
        margin:0 0 10px;
        font-size:22px;
        line-height:1.18;
      }

      .side-card p{
        margin:0 0 14px;
        color:var(--muted);
      }

      .faq{
        display:grid;
        gap:12px;
      }

      details{
        border:1px solid var(--line);
        border-radius:14px;
        background:#fff;
        padding:14px;
      }

      summary{
        cursor:pointer;
        font-weight:800;
      }

      details p{
        margin:10px 0 0;
        color:var(--muted);
      }

      footer{
        padding:34px 0 44px;
        color:var(--muted);
        font-size:13px;
      }

      .foot{
        display:grid;
        grid-template-columns:1.1fr auto;
        gap:18px;
        align-items:start;
        border-top:1px solid var(--line);
        padding-top:20px;
      }

      .footer-brand strong{
        display:block;
        color:var(--text);
        margin-bottom:6px;
        font-size:15px;
      }

      .footer-actions{
        display:flex;
        flex-wrap:wrap;
        gap:10px;
        justify-content:flex-end;
      }

            .footer-grid{
        display:grid;
        grid-template-columns:1.1fr repeat(4, minmax(130px, 1fr));
        gap:24px;
        align-items:start;
        border-top:1px solid var(--line);
        padding-top:24px;
      }

      .footer-group h3{
        margin:0 0 10px;
        color:var(--text);
        font-size:14px;
        line-height:1.2;
      }

      .footer-group nav{
        display:grid;
        gap:8px;
      }

      .footer-group a{
        color:var(--muted);
        font-size:13px;
        line-height:1.35;
      }

      .footer-group a:hover{
        color:var(--text);
        text-decoration:underline;
        text-underline-offset:2px;
      }

      @media (max-width: 900px){
        .nav{
          position:relative;
          gap:10px;
        }

        .navlinks{
          display:none;
        }

        .mobile-menu{
          display:block;
        }

        .nav > .btn.primary{
          display:none;
        }

        .mobile-menu{
          margin-left:auto;
        }

        h1{max-width:none}
        .intent-grid{grid-template-columns:1fr}
        .side-card{position:static}
        .foot{grid-template-columns:1fr}
        .footer-actions{justify-content:flex-start}
        .footer-grid{grid-template-columns:1fr}
      }

      @media (max-width: 520px){
        .wrap{
          padding:18px;
        }

        .mobile-menu__panel{
          right:0;
          left:auto;
          top:70px;
          min-width:220px;
        }
      }
    </style>
  </head>

  <body>
    <div class="wrap">
      <header class="nav">
        <a class="logo" href="https://ecommony.com" aria-label="Ecommony home">
          <span class="mark" aria-hidden="true">
            <img src="/assets/ecommony-mark.png" alt="" />
          </span>
          <span>Ecommony</span>
        </a>

        <nav class="navlinks" aria-label="Primary">
          <a href="https://ecommony.com/">Home</a>
          <a href="/services/">Services</a>
          <a href="/guides/">Guides</a>
          <a href="/industries/">Industries</a>
          <a href="/blog/">Blog</a>
        </nav>

        <details class="mobile-menu">
          <summary class="btn" aria-label="Open navigation menu">Menu</summary>
          <nav class="mobile-menu__panel" aria-label="Mobile primary">
            <a href="https://ecommony.com/">Home</a>
            <a href="/services/">Services</a>
            <a href="/guides/">Guides</a>
            <a href="/industries/">Industries</a>
            <a href="/blog/">Blog</a>
            <a href="/ecommerce-consultant-london/">London support</a>
<a href="/contact/">Contact</a>
          </nav>
        </details>

        <a class="btn primary" href="/contact/">Contact</a>
      </header>

      <slot />

      <footer>
        <div class="footer-grid">
          <div class="footer-brand">
            <strong>Ecommony</strong>
            <span>Ecommerce technical consulting for Shopify, Magento and WordPress — focused on speed, conversion, SEO and tracking confidence.</span>
          </div>

          <div class="footer-group">
            <h3>Core pages</h3>
            <nav aria-label="Footer core pages">
              <a href="/services/">Services</a>
              <a href="/guides/">Guides</a>
              <a href="/industries/">Industries</a>
              <a href="/blog/">Blog</a>
              <a href="/contact/">Contact</a>
            </nav>
          </div>

          <div class="footer-group">
            <h3>Common problems</h3>
            <nav aria-label="Footer common problems">
              <a href="/ga4-ecommerce-tracking-not-working/">GA4 ecommerce tracking not working</a>
              <a href="/shopify-ga4-revenue-not-matching/">Shopify and GA4 revenue not matching</a>
              <a href="/shopify-site-slow/">Shopify site slow</a>
              <a href="/shopify-conversion-rate-low/">Shopify conversion rate low</a>
            </nav>
          </div>

          <div class="footer-group">
            <h3>London support</h3>
            <nav aria-label="Footer London support">
              <a href="/ecommerce-consultant-london/">Ecommerce consultant London</a>
              <a href="/shopify-consultant-london/">Shopify consultant London</a>
              <a href="/technical-seo-consultant-london/">Technical SEO consultant London</a>
              <a href="/ga4-tracking-consultant-london/">GA4 tracking consultant London</a>
            </nav>
          </div>

          <div class="footer-group">
            <h3>Legal</h3>
            <nav aria-label="Footer legal pages">
              <a href="/privacy-policy/">Privacy policy</a>
              <a href="/cookie-policy/">Cookie policy</a>
              <a href="/terms-and-conditions/">Terms and conditions</a>
            </nav>
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>