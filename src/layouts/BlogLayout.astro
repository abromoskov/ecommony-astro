---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/ecommony.css';
const {
  title = 'Ecommony Blog',
  description = 'Technical ecommerce articles on Shopify, Magento, WordPress, SEO, tracking and site speed.',
  type = 'article',
  image = '',
  excerpt = '',
  references = []
} = Astro.props;

const siteUrl = 'https://ecommony.com';

const seoTitle = title.includes('Ecommony') ? title : `${title} | Ecommony`;

// Clean fallback logic (safe + predictable)
const seoDescription =
  description && description.length > 110
    ? description
    : `${title} — what’s causing it, how it impacts performance and what to check first.`;


const seoCanonical = `${siteUrl}${Astro.url.pathname}`;

const { site } = Astro;

const fallbackImage = '/images/blog-default.jpg';
const finalImage = image || fallbackImage;

const fullImage = new URL(finalImage, site).toString();
---

<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
   
    <title>{seoTitle}</title>
<meta name="description" content={seoDescription} />
<link rel="canonical" href={seoCanonical} />
<meta name="robots" content="index,follow" />
<meta property="og:image" content={fullImage} />
<meta property="og:title" content={seoTitle} />
<meta property="og:description" content={seoDescription} />
<meta property="og:type" content={type} />
<meta property="og:url" content={seoCanonical} />
<meta property="og:site_name" content="Ecommony" />
<meta name="twitter:label1" content="Type" />
<meta name="twitter:data1" content={type} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={seoTitle} />
<meta name="twitter:description" content={seoDescription} />
<meta name="twitter:image" content={fullImage} />
 
  </head>

  <body>
    <div class="wrap">
     <SiteHeader />

      <slot />
     

   {references.length > 0 && (
  <section class="references">
    <h3>References</h3>
    <ul>
      {references.map((ref) => (
        <li>
          <a href={ref.url} target="_blank" rel="noopener noreferrer">
            {ref.label}
          </a>
        </li>
      ))}
    </ul>
  </section>
)}

      <SiteFooter />
    </div>
    <!-- Google tag (gtag.js) — delayed until idle to protect first paint -->
  <link rel="preconnect" href="https://www.googletagmanager.com">
  <link rel="dns-prefetch" href="//www.googletagmanager.com">

  <script>
    window.dataLayer = window.dataLayer || [];
    window.gtag = function(){ window.dataLayer.push(arguments); };

    function loadEcommonyGA4(){
      if (window.__ecommonyGA4Loaded) return;
      window.__ecommonyGA4Loaded = true;

      const script = document.createElement('script');
      script.async = true;
      script.src = 'https://www.googletagmanager.com/gtag/js?id=G-BFJDYQHSPM';
      document.head.appendChild(script);

      window.gtag('js', new Date());
      window.gtag('config', 'G-BFJDYQHSPM');
    }

    if ('requestIdleCallback' in window) {
      window.requestIdleCallback(loadEcommonyGA4, { timeout: 3000 });
    } else {
      window.addEventListener('load', function(){
        window.setTimeout(loadEcommonyGA4, 1000);
      });
    }
  </script>
  <script defer src="https://cdn.kiprotect.com/klaro/v0.7/klaro.min.js"></script>
  </body>
</html>
