---
import SiteFooter from '../components/SiteFooter.astro';
const {
  title = 'Ecommony Blog',
  description = 'Technical ecommerce articles on Shopify, Magento, WordPress, SEO, tracking and site speed.',
  type = 'article',
  image = '',
  excerpt = '',
  references = []
} = Astro.props;

const siteUrl = 'https://ecommony.com';

const seoTitle = title.includes('Ecommony') ? title : `${title} | Ecommony`;

// Clean fallback logic (safe + predictable)
const seoDescription =
  description && description.length > 110
    ? description
    : `${title} — what’s causing it, how it impacts performance and what to check first.`;


const seoCanonical = `${siteUrl}${Astro.url.pathname}`;

const { site } = Astro;

const fallbackImage = '/images/blog-default.jpg';
const finalImage = image || fallbackImage;

const fullImage = new URL(finalImage, site).toString();
---

<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-BFJDYQHSPM"></script>
    <!-- Google tag (gtag.js) -->
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-BFJDYQHSPM');
    </script>
    <title>{seoTitle}</title>
<meta name="description" content={seoDescription} />
<link rel="canonical" href={seoCanonical} />
<meta name="robots" content="index,follow" />
<meta property="og:image" content={fullImage} />
<meta property="og:title" content={seoTitle} />
<meta property="og:description" content={seoDescription} />
<meta property="og:type" content={type} />
<meta property="og:url" content={seoCanonical} />
<meta property="og:site_name" content="Ecommony" />
<meta name="twitter:label1" content="Type" />
<meta name="twitter:data1" content={type} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={seoTitle} />
<meta name="twitter:description" content={seoDescription} />
<meta name="twitter:image" content={fullImage} />
    <style is:global>
      :root{
        --bg:#f5f1ea;
        --text:#101826;
        --muted:#5f6775;
        --muted2:#7b8494;
        --line:rgba(16,24,38,.10);
        --brand:#c58a2d;
        --brand2:#1b2b44;
        --accent:#1b2b44;
        --shadow:0 16px 44px rgba(11,18,32,.10);
        --shadow2:0 10px 28px rgba(11,18,32,.08);
        --radius:18px;
        --max:1120px;
      }

      *{box-sizing:border-box}
      html{scroll-behavior:smooth}
      body{
        margin:0;
        font-family:ui-sans-serif,system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial,"Apple Color Emoji","Segoe UI Emoji";
        color:var(--text);
        background:var(--bg);
        line-height:1.65;
        position:relative;
      }

      body::before{
        content:"";
        position:fixed;
        inset:0;
        pointer-events:none;
        z-index:-1;
        background:
          radial-gradient(1100px 700px at 10% 0%, rgba(197,138,45,.10), transparent 64%),
          radial-gradient(900px 620px at 90% 8%, rgba(27,43,68,.10), transparent 62%),
          radial-gradient(1000px 700px at 50% 100%, rgba(197,138,45,.05), transparent 68%),
          linear-gradient(180deg,#f7f3ec 0%,#f3eee7 100%);
        background-repeat:no-repeat;
      }

      a{color:inherit;text-decoration:none}
      img{max-width:100%;height:auto;display:block}

      .wrap{max-width:var(--max);margin:0 auto;padding:24px}

      .nav{
        display:flex;
        align-items:center;
        justify-content:space-between;
        gap:16px;
        padding:14px 0 22px;
      }

      .logo{
        display:flex;
        gap:10px;
        align-items:center;
        font-weight:800;
        letter-spacing:.2px;
      }

      .mark{
        width:34px;
        height:34px;
        display:inline-flex;
        align-items:center;
        justify-content:center;
        flex:0 0 auto;
      }

      .mark img{
        width:100%;
        height:100%;
        object-fit:contain;
      }

      .navlinks{
        display:flex;
        gap:10px;
        align-items:center;
        flex-wrap:wrap;
      }

      .navlinks a{
        padding:10px 12px;
        border-radius:12px;
        color:var(--muted);
      }

      .mobile-menu{
        display:none;
      }

      .mobile-menu summary{
        list-style:none;
      }

      .mobile-menu summary::-webkit-details-marker{
        display:none;
      }

      .mobile-menu__panel{
        position:absolute;
        right:24px;
        top:78px;
        z-index:20;
        display:grid;
        gap:10px;
        min-width:260px;
        padding:14px;
        border:1px solid var(--line);
        border-radius:16px;
        background:#fff;
        box-shadow:var(--shadow);
      }

      .mobile-menu__panel a{
        display:flex;
        align-items:center;
        width:100%;
        min-height:46px;
        padding:12px 14px;
        border:1px solid var(--line);
        border-radius:12px;
        background:#fff;
        color:var(--text);
        font-weight:700;
        line-height:1.25;
      }

      .mobile-menu__panel a:hover{
        background:rgba(11,18,32,.04);
      }

      .btn{
        display:inline-flex;
        align-items:center;
        justify-content:center;
        gap:10px;
        padding:12px 16px;
        border-radius:14px;
        border:1px solid var(--line);
        background:#fff;
        color:var(--text);
        box-shadow:var(--shadow2);
        transition:transform .08s ease, box-shadow .2s ease, border-color .2s ease;
        cursor:pointer;
        font-weight:700;
      }

      .btn:hover{
        border-color:rgba(11,18,32,.18);
        box-shadow:0 14px 36px rgba(11,18,32,.10);
      }

      .btn.primary{
        background:linear-gradient(135deg,rgba(37,99,235,1),rgba(16,185,129,1));
        border-color:transparent;
        color:#fff;
        box-shadow:0 18px 44px rgba(37,99,235,.18);
      }

      .hero{
        padding:10px 0 22px;
      }

      .pill{
        display:inline-flex;
        align-items:center;
        gap:10px;
        padding:8px 12px;
        border:1px solid var(--line);
        border-radius:999px;
        background:rgba(255,255,255,.78);
        color:var(--muted);
        font-size:13px;
        box-shadow:var(--shadow2);
      }

      h1{
        margin:16px 0 10px;
        font-size:clamp(34px,4.6vw,56px);
        line-height:1.04;
        letter-spacing:-1px;
        max-width:14ch;
      }

      .sub{
        font-size:clamp(17px,1.8vw,21px);
        color:var(--muted);
        max-width:64ch;
        margin:0;
      }

      .content-card{
        background:rgba(255,255,255,.90);
        border:1px solid var(--line);
        border-radius:var(--radius);
        box-shadow:var(--shadow);
        padding:22px;
      }

      .article-list{
        list-style:none;
        padding:0;
        margin:0;
        display:grid;
        gap:16px;
      }

      .article-item{
        padding:18px;
        border:1px solid var(--line);
        border-radius:16px;
        background:rgba(255,255,255,.86);
        box-shadow:var(--shadow2);
      }

      .article-item h2{
        margin:0 0 8px;
        font-size:24px;
        line-height:1.2;
        letter-spacing:-.4px;
      }

      .article-item p{
        margin:0 0 8px;
        color:var(--muted);
      }

      .meta{
        color:var(--muted2);
        font-size:14px;
      }
      .prose{
        max-width:780px;
        font-size:20px;
        line-height:1.82;
      }

      .prose h1{
        max-width:none;
        font-size:clamp(36px,4.2vw,52px);
        margin:0 0 12px;
        line-height:1.06;
        letter-spacing:-.8px;
      }

      .prose h2{
        margin:40px 0 14px;
        font-size:clamp(28px,2.4vw,34px);
        line-height:1.14;
        letter-spacing:-.4px;
      }

    .prose h3 {
      margin-top: 1.5rem;
      margin-left: 0.25rem;
      font-size: 2.05rem;
      color: #444;
    }

    .cta-link {
  color: #0a66ff;
  text-decoration: underline;
  font-weight: 500;
}

.cta-link:hover {
  text-decoration: none;
}

      .prose p{
        margin:0 0 18px;
        color:var(--text);
        font-size:20px;
        line-height:1.82;
      }

      .prose ul{
        margin:0 0 22px 0;
        padding-left:24px;
      }

      .prose li{
        margin:0 0 10px;
        font-size:19px;
        line-height:1.75;
        color:var(--text);
      }

      .prose hr{
        border:0;
        border-top:1px solid var(--line);
        margin:30px 0;
      }

      .prose strong{
        color:var(--text);
      }

      .prose blockquote{
        margin:28px 0;
        padding:18px 20px;
        border-left:4px solid var(--brand);
        background:rgba(255,255,255,.72);
        border-radius:14px;
        box-shadow:var(--shadow2);
      }

      @media (max-width: 900px){
        .prose{
          max-width:none;
          font-size:18px;
          line-height:1.75;
        }

        .prose p,
        .prose li{
          font-size:18px;
          line-height:1.75;
        }

        .prose h2{
          font-size:28px;
        }

        .prose h3{
          font-size:22px;
        }
      }
   
      .eyebrow{
        display:inline-flex;
        align-items:center;
        gap:8px;
        color:var(--muted2);
        font-size:13px;
        font-weight:700;
        text-transform:uppercase;
        letter-spacing:.08em;
        margin-bottom:12px;
      }

      .article-header{
        margin-bottom:26px;
        padding-bottom:18px;
        border-bottom:1px solid var(--line);
      }

      .article-header .meta{
        margin-top:10px;
      }

      .hero-image {
  width: 100%;
  height: auto;
  border-radius: 12px;
  margin: 20px 0;
}


      .related-commercial-card{
        margin-top:34px;
        padding:24px;
        border-radius:20px;
        background:#fff;
        border:1px solid var(--line);
        box-shadow:var(--shadow2);
      }

      .related-commercial-card h2{
        margin:8px 0 10px;
        font-size:clamp(24px,2.4vw,34px);
        line-height:1.12;
        letter-spacing:-.5px;
      }

      .related-commercial-card p{
        margin:0 0 14px;
        color:var(--muted);
        font-size:18px;
      }

      .cta-band{
        margin-top:34px;
        padding:22px;
        background:linear-gradient(135deg, rgba(37,99,235,.06), rgba(16,185,129,.08));
        border:1px solid var(--line);
        border-radius:18px;
        box-shadow:var(--shadow2);
      }

      .cta-band h3{
        margin:0 0 8px;
        font-size:22px;
      }

      .cta-band p{
        margin:0 0 14px;
        color:var(--muted);
      }

      .references {
  margin-top: 3rem;
  padding-top: 1.5rem;
  border-top: 1px solid #eee;
}

.references h3 {
  margin-bottom: 0.75rem;
}

.references ul {
  padding-left: 1rem;
}

.references li {
  margin-bottom: 0.5rem;
}

      footer{
        padding:30px 0 44px;
        color:var(--muted);
        font-size:13px;
      }

      .foot{
        display:grid;
        grid-template-columns:1.1fr auto;
        gap:18px;
        align-items:start;
        border-top:1px solid var(--line);
        padding-top:20px;
      }

      .footer-brand strong{
        display:block;
        color:var(--text);
        margin-bottom:6px;
        font-size:15px;
      }

      .footer-actions{
        display:flex;
        flex-wrap:wrap;
        gap:10px;
        justify-content:flex-end;
      }
            .footer-grid{
        display:grid;
        grid-template-columns:1.1fr repeat(4, minmax(130px, 1fr));
        gap:24px;
        align-items:start;
        border-top:1px solid var(--line);
        padding-top:24px;
      }

      .footer-group h3{
        margin:0 0 10px;
        color:var(--text);
        font-size:14px;
        line-height:1.2;
      }

      .footer-group nav{
        display:grid;
        gap:8px;
      }

      .footer-group a{
        color:var(--muted);
        font-size:13px;
        line-height:1.35;
      }

      .footer-group a:hover{
        color:var(--text);
        text-decoration:underline;
        text-underline-offset:2px;
      }

      @media (max-width: 900px){
        .nav{
          position:relative;
          gap:10px;
        }

        .navlinks{
          display:none;
        }

        .mobile-menu{
          display:block;
          margin-left:auto;
        }

        .nav > .btn.primary{
          display:none;
        }

        h1{max-width:none}
        .foot{grid-template-columns:1fr}
        .footer-actions{justify-content:flex-start}
        .footer-grid{grid-template-columns:1fr}
        .content-card{padding:18px}
      }

      @media (max-width: 700px){
        .content-card{
          padding:0!important;
          border:0!important;
          box-shadow:none!important;
          background:transparent!important;
        }
      }

      @media (max-width: 520px){
        .wrap{
          padding:18px;
        }

        .mobile-menu__panel{
          right:0;
          left:auto;
          top:70px;
          width:min(88vw,320px);
          min-width:280px;
        }
      }
    </style>
  </head>

  <body>
    <div class="wrap">
      <header class="nav">
        <a class="logo" href="https://ecommony.com" aria-label="Ecommony home">
          <span class="mark" aria-hidden="true">
            <img src="/assets/ecommony-mark.png" alt="" />
          </span>
          <span>Ecommony</span>
        </a>

        <nav class="navlinks" aria-label="Primary">
          <a href="https://ecommony.com/">Home</a>
          <a href="/#platforms">Platforms</a>
          <a href="/services/">Services</a>
          <a href="/blog/">Blog</a>
          <a href="/contact/">Contact</a>
        </nav>

        <details class="mobile-menu">
          <summary class="btn" aria-label="Open navigation menu">Menu</summary>
          <nav class="mobile-menu__panel" aria-label="Mobile primary">
            <a href="https://ecommony.com/">Home</a>
            <a href="/#platforms">Platforms</a>
            <a href="/services/">Services</a>
            <a href="/blog/">Blog</a>
            <a href="/ecommerce-consultant-london/">London support</a>
            <a href="/contact/">Contact</a>
          </nav>
        </details>

        <a class="btn primary" href="/contact/">Contact</a>
      </header>

      <slot />
     

   {references.length > 0 && (
  <section class="references">
    <h3>References</h3>
    <ul>
      {references.map((ref) => (
        <li>
          <a href={ref.url} target="_blank" rel="noopener noreferrer">
            {ref.label}
          </a>
        </li>
      ))}
    </ul>
  </section>
)}

      <SiteFooter />
    </div>
  </body>
</html>
