---
import IntentPageLayout from '../../layouts/IntentPageLayout.astro';
import { locationPages, getLocationPagePath } from '../../data/locationPages';

export function getStaticPaths() {
  return locationPages.map((page) => ({
    params: {
      slug: page.slug,
    },
    props: {
      page,
    },
  }));
}

const { page } = Astro.props;

const siteUrl = 'https://ecommony.com';
const pageUrl = `${siteUrl}${getLocationPagePath(page)}`;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: `${siteUrl}/`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: page.eyebrow,
      item: pageUrl,
    },
  ],
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Ecommony',
  url: pageUrl,
  areaServed: {
    '@type': 'City',
    name: 'London',
  },
  serviceType: page.serviceType,
  description: page.description,
  email: 'nigel@ecommony.com',
  telephone: '+447877932578',
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: page.faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};
---

<IntentPageLayout
  title={page.title}
  description={page.description}
  eyebrow={page.eyebrow}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a>
    <span aria-hidden="true">/</span>
    <span>{page.eyebrow}</span>
  </nav>

  <section class="intent-hero">
    <span class="pill">{page.eyebrow}</span>
    <h1>{page.title}</h1>
    <p class="sub">{page.description}</p>
  </section>

  <div class="intent-grid">
    <main class="content-card">
      <section class="section-block">
        <h2>London ecommerce support with a practical commercial focus</h2>
        <p>{page.intro}</p>
      </section>

      <section class="section-block">
        <h2>When this is worth looking at</h2>
        <ul class="check-list">
          {page.symptoms.map((item) => <li>{item}</li>)}
        </ul>
      </section>

      <section class="section-block">
        <h2>How Ecommony helps</h2>
        <ul class="check-list">
          {page.help.map((item) => <li>{item}</li>)}
        </ul>
      </section>

      <section class="section-block">
        <h2>Related services and guides</h2>
        <div class="location-link-grid">
          {page.relatedLinks.map((link) => (
            <a class="location-link-card" href={link.href}>
              <h3>{link.label}</h3>
              <p>{link.description}</p>
              <span>Read more →</span>
            </a>
          ))}
        </div>
      </section>

      <section class="section-block">
        <h2>Questions this page answers</h2>
        <div class="faq">
          {page.faqs.map((faq) => (
            <details>
              <summary>{faq.question}</summary>
              <p>{faq.answer}</p>
            </details>
          ))}
        </div>
      </section>
    </main>

    <aside class="side-card">
      <h2>Talk through the problem</h2>
      <p>
        If you need London-based ecommerce, SEO, Shopify, GA4 or technical growth support,
        start with a short enquiry.
      </p>
      <a class="btn primary" href="/contact/">Contact Ecommony</a>

      <hr style="border:0;border-top:1px solid rgba(11,18,32,.10);margin:22px 0;" />

      <h2>Start with diagnosis</h2>
      <p>
        Not sure what is limiting growth? Use the free audit to identify the likely speed,
        SEO, conversion and tracking constraints first.
      </p>
      <a class="btn" href="/#start-audit">Start free audit</a>
    </aside>
  </div>
</IntentPageLayout>

<style>
  .location-link-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .location-link-card {
    display: block;
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: #fff;
    box-shadow: var(--shadow2);
  }

  .location-link-card h3 {
    margin: 0 0 8px;
    font-size: 20px;
    line-height: 1.18;
    letter-spacing: -.25px;
  }

  .location-link-card p {
    margin: 0 0 12px;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.55;
  }

  .location-link-card span {
    font-weight: 800;
  }

  @media (max-width: 900px) {
    .location-link-grid {
      grid-template-columns: 1fr;
    }
  }
</style>