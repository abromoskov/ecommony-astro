---
import IntentPageLayout from '../../layouts/IntentPageLayout.astro';
import { locationPages, getLocationPagePath } from '../../data/locationPages';
import { problemPages, getProblemPagePath } from '../../data/problemPages';

export function getStaticPaths() {
  return [
    ...locationPages.map((page) => ({
      params: {
        slug: page.slug,
      },
      props: {
        page: {
          ...page,
          pageKind: 'location',
          path: getLocationPagePath(page),
        },
      },
    })),
    ...problemPages.map((page) => ({
      params: {
        slug: page.slug,
      },
      props: {
        page: {
          ...page,
          pageKind: 'problem',
          path: getProblemPagePath(page),
        },
      },
    })),
  ];
}

const { page } = Astro.props;

const siteUrl = 'https://ecommony.com';
const pageUrl = `${siteUrl}${page.path}`;

const hasSummary = 'summary' in page && Boolean(page.summary);
const hasProblemSections = page.pageKind === 'problem';
const hasSources = 'sources' in page && Array.isArray(page.sources) && page.sources.length > 0;
const hasInterpretation = 'ecommonyInterpretation' in page && Boolean(page.ecommonyInterpretation);
const hasWhatBreaks = 'whatBreaks' in page && Array.isArray(page.whatBreaks) && page.whatBreaks.length > 0;
const hasScoring =
  Boolean(page.scoringTitle) &&
  Boolean(page.scoringIntro) &&
  Array.isArray(page.scoringBands) &&
  page.scoringBands.length > 0;
const hasWhatToCheckFirst =
  'whatToCheckFirst' in page &&
  Array.isArray(page.whatToCheckFirst) &&
  page.whatToCheckFirst.length > 0;

const hasRichHero = Boolean(page.hero);
const hasQuickAnswer = Boolean(page.quickAnswer);
const hasLocationProblemGroups =
  Array.isArray(page.problemGroups) && page.problemGroups.length > 0;
const hasCommercialImpact = Boolean(page.commercialImpact);
const hasProcess = Boolean(page.process) && Array.isArray(page.process.steps) && page.process.steps.length > 0;
const hasProof = Boolean(page.proof);
const hasFinalCta = Boolean(page.finalCta);

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: `${siteUrl}/`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: page.eyebrow,
      item: pageUrl,
    },
  ],
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Ecommony',
  url: pageUrl,
  areaServed: page.pageKind === 'location'
    ? {
        '@type': 'City',
        name: 'London',
      }
    : 'GB',
  serviceType: page.serviceType,
  description: page.description,
  email: 'nigel@ecommony.com',
  telephone: '+447877932578',
};

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: page.title,
  description: page.description,
  url: pageUrl,
  isPartOf: {
    '@type': 'WebSite',
    name: 'Ecommony',
    url: siteUrl,
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: page.faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};
---

<IntentPageLayout
  title={page.title}
  description={page.description}
  eyebrow={page.eyebrow}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a>
    <span aria-hidden="true">/</span>
    <span>{page.eyebrow}</span>
  </nav>

  <section class={hasRichHero ? 'intent-hero intent-hero--rich' : 'intent-hero'}>
    <h1>{page.h1 || page.title}</h1>
    <p class="sub">{hasRichHero ? page.hero.summary : page.description}</p>

    {hasRichHero && page.hero.bullets?.length > 0 && (
      <ul class="hero-proof-list">
        {page.hero.bullets.map((item) => <li>{item}</li>)}
      </ul>
    )}

    {hasRichHero && (page.hero.primaryCta || page.hero.secondaryCta) && (
      <div class="hero-actions">
        {page.hero.primaryCta && (
          <a class="btn primary" href={page.hero.primaryCta.href}>
            {page.hero.primaryCta.label}
          </a>
        )}

        {page.hero.secondaryCta && (
          <a class="btn" href={page.hero.secondaryCta.href}>
            {page.hero.secondaryCta.label}
          </a>
        )}
      </div>
    )}
  </section>

  {hasSummary && (
    <section class="summary-card" aria-label="Summary">
      <p>{page.summary}</p>
    </section>
  )}

  <div class="intent-grid">
    <main class="content-card">
      {hasQuickAnswer && (
        <section class="section-block section-block--lead">
          <h2>{page.quickAnswer.heading}</h2>
          <p>{page.quickAnswer.body}</p>
        </section>
      )}

      <section class="section-block">
        <h2>{page.introTitle || 'London ecommerce support with a practical commercial focus'}</h2>
        <p>{page.intro}</p>
      </section>

      <section class="section-block">
        <h2>{hasProblemSections ? 'Common symptoms' : 'When this is worth looking at'}</h2>
        <ul class="check-list">
          {page.symptoms.map((item) => <li>{item}</li>)}
        </ul>
      </section>

      {hasLocationProblemGroups && (
        <section class="section-block">
          <h2>Where ecommerce growth usually leaks</h2>
          <div class="problem-group-list">
            {page.problemGroups.map((group) => (
              <article class="problem-group-card">
                <h3>{group.heading}</h3>
                <p>{group.body}</p>

                <div class="problem-group-columns">
                  <div>
                    <h4>Common signs</h4>
                    <ul class="check-list">
                      {group.symptoms.map((item) => <li>{item}</li>)}
                    </ul>
                  </div>

                  <div>
                    <h4>What Ecommony checks</h4>
                    <ul class="check-list">
                      {group.checks.map((item) => <li>{item}</li>)}
                    </ul>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </section>
      )}

      {hasCommercialImpact && (
        <section class="section-block interpretation-card">
          <h2>{page.commercialImpact.heading}</h2>
          <p>{page.commercialImpact.body}</p>

          {page.commercialImpact.bullets?.length > 0 && (
            <ul class="check-list">
              {page.commercialImpact.bullets.map((item) => <li>{item}</li>)}
            </ul>
          )}
        </section>
      )}

      {hasWhatBreaks && (
        <section class="section-block">
          <h2>What usually breaks</h2>
          <ul class="check-list">
            {page.whatBreaks.map((item) => <li>{item}</li>)}
          </ul>
        </section>
      )}

      {hasScoring && (
        <section class="section-block">
          <h2>{page.scoringTitle}</h2>
          <p>{page.scoringIntro}</p>
          <ul class="check-list">
            {page.scoringBands?.map((item) => <li>{item}</li>)}
          </ul>
        </section>
      )}

      {hasWhatToCheckFirst && (
        <section class="section-block">
          <h2>What to check first</h2>
          <p>For a quick diagnosis:</p>
          <ul class="check-list">
            {page.whatToCheckFirst.map((item) => <li>{item}</li>)}
          </ul>
        </section>
      )}

      {hasSources && (
        <section class="section-block evidence-block">
          <h2>Evidence base</h2>
          <p>{page.evidenceIntro}</p>

          <div class="source-list">
            {page.sources.map((source) => (
              <a class="source-card" href={source.url} rel="noopener noreferrer" target="_blank">
                <h3>{source.label}</h3>
                <p>{source.note}</p>
                <span>View source →</span>
              </a>
            ))}
          </div>
        </section>
      )}

      {hasInterpretation && (
        <section class="section-block interpretation-card">
          <h2>Ecommony interpretation</h2>
          <p>{page.ecommonyInterpretation}</p>
        </section>
      )}

      <section class="section-block">
        <h2>How Ecommony helps</h2>
        <ul class="check-list">
          {page.help.map((item) => <li>{item}</li>)}
        </ul>
      </section>

      {hasProcess && (
        <section class="section-block">
          <h2>{page.process.heading}</h2>
          <div class="process-list">
            {page.process.steps.map((step, index) => (
              <article class="process-step">
                <span>{index + 1}</span>
                <div>
                  <h3>{step.title}</h3>
                  <p>{step.description}</p>
                </div>
              </article>
            ))}
          </div>
        </section>
      )}

      {hasProof && (
        <section class="section-block interpretation-card">
          <h2>{page.proof.heading}</h2>
          <p>{page.proof.body}</p>

          {page.proof.bullets?.length > 0 && (
            <ul class="check-list">
              {page.proof.bullets.map((item) => <li>{item}</li>)}
            </ul>
          )}
        </section>
      )}

      <section class="section-block">
        <h2>Related services and guides</h2>
        <div class="location-link-grid">
          {page.relatedLinks.map((link) => (
            <a class="location-link-card" href={link.href}>
              <h3>{link.label}</h3>
              <p>{link.description}</p>
              <span>Read more →</span>
            </a>
          ))}
        </div>
      </section>

      <section class="section-block">
        <h2>Questions this page answers</h2>
        <div class="faq">
          {page.faqs.map((faq) => (
            <details>
              <summary>{faq.question}</summary>
              <p>{faq.answer}</p>
            </details>
          ))}
        </div>
      </section>

      {hasFinalCta && (
        <section class="section-block final-cta-card">
          <h2>{page.finalCta.heading}</h2>
          <p>{page.finalCta.body}</p>

          <div class="hero-actions">
            <a class="btn primary" href={page.finalCta.primaryCta.href}>
              {page.finalCta.primaryCta.label}
            </a>

            {page.finalCta.secondaryCta && (
              <a class="btn" href={page.finalCta.secondaryCta.href}>
                {page.finalCta.secondaryCta.label}
              </a>
            )}
          </div>
        </section>
      )}
    </main>

    <aside class="side-card">
      <h2>{hasRichHero ? 'Find the revenue leaks' : hasProblemSections ? 'Need the tracking checked?' : 'Talk through the problem'}</h2>
      <p>
        {hasRichHero
          ? 'If your ecommerce site is getting traffic but not enough profitable revenue, start with a focused diagnosis of acquisition, conversion, tracking, retention and channel mix.'
          : hasProblemSections
            ? 'If GA4, GTM, Shopify or paid media reporting no longer looks reliable, start with a focused tracking review.'
            : 'If you need London-based ecommerce, SEO, Shopify, GA4 or technical growth support, start with a short enquiry.'}
      </p>
      <a class="btn primary" href="/contact/">
        {hasRichHero ? 'Find where money is being lost' : 'Contact Ecommony'}
      </a>

      <hr style="border:0;border-top:1px solid rgba(11,18,32,.10);margin:22px 0;" />

      <h2>Start with diagnosis</h2>
      <p>
        Not sure what is limiting growth? Use the free audit to identify the likely speed,
        SEO, conversion and tracking constraints first.
      </p>
      <a class="btn" href="/#start-audit">Start free audit</a>
    </aside>
  </div>
</IntentPageLayout>