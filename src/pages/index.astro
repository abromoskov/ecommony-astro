  <script>
    window.trackEcommonyEvent = function(eventName, params = {}) {
      if (typeof window.gtag === "function") {
        window.gtag("event", eventName, {
          event_category: "engagement",
          transport_type: "beacon",
          ...params
        });
      }
    };

    document.addEventListener("click", function(e) {
      const link = e.target.closest("a");
      if (!link) return;

      const href = link.getAttribute("href") || "";

      if (href.startsWith("mailto:")) {
        window.trackEcommonyEvent("click_email", {
          event_label: href.replace("mailto:", ""),
          link_url: href
        });
      }

      if (href.startsWith("tel:")) {
        window.trackEcommonyEvent("click_phone", {
          event_label: href.replace("tel:", ""),
          link_url: href
        });
      }

      if (href === "#start-audit" || href === "/#start-audit" || href.includes("#start-audit")) {
        window.trackEcommonyEvent("click_audit_cta", {
          event_label: link.textContent.trim(),
          link_url: href
        });
      }

      if (href === "#contact" || href === "/contact/" || href.includes("/contact/")) {
        window.trackEcommonyEvent("click_contact_cta", {
          event_label: link.textContent.trim(),
          link_url: href
        });
      }
    });
  </script>

  <script>
    const form = document.getElementById("contactForm");
    const msg = document.getElementById("formMsg");

    const getVal = (id) => {
      const el = document.getElementById(id);
      return el && typeof el.value === "string" ? el.value.trim() : "";
    };

    const clearFieldError = (field) => {
      field.classList.remove("input-error");
      const next = field.nextElementSibling;
      if (next && next.classList.contains("field-error")) {
        next.remove();
      }
    };

    const setFieldError = (field, text) => {
      clearFieldError(field);
      field.classList.add("input-error");
      const error = document.createElement("p");
      error.className = "field-error";
      error.textContent = text;
      field.insertAdjacentElement("afterend", error);
    };

    const normaliseUrl = (value) => {
      if (!value) return "";
      let v = value.trim();
      if (!/^https?:\/\//i.test(v)) {
        v = "https://" + v;
      }
      return v;
    };

    const isValidEmail = (value) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value);

    if (form) {
      const submitBtn = form.querySelector('button[type="submit"]');

      let auditFormStarted = false;
      form.addEventListener("input", () => {
        if (!auditFormStarted) {
          auditFormStarted = true;
          window.trackEcommonyEvent("audit_form_start", {
            form_id: "contactForm",
            form_name: "Free audit form"
          });
        }
      }, { once: true });

      ["name", "email", "url", "notes"].forEach((id) => {
        const field = document.getElementById(id);
        if (field) {
          field.addEventListener("input", () => clearFieldError(field));
        }
      });

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        if (msg) msg.textContent = "";

        const nameField = document.getElementById("name");
        const emailField = document.getElementById("email");
        const urlField = document.getElementById("url");

        const name = getVal("name");
        const email = getVal("email");
        const urlRaw = getVal("url");
        const url = normaliseUrl(urlRaw);
        const notes = getVal("notes");
        const company = getVal("company");

        let hasError = false;

        [nameField, emailField, urlField].forEach((field) => {
          if (field) clearFieldError(field);
        });

        if (!name) {
          setFieldError(nameField, "Please enter your name.");
          hasError = true;
        }

        if (!email) {
          setFieldError(emailField, "Please enter your email.");
          hasError = true;
        } else if (!isValidEmail(email)) {
          setFieldError(emailField, "Please enter a valid email address.");
          hasError = true;
        }

        if (!urlRaw) {
          setFieldError(urlField, "Please enter your website.");
          hasError = true;
        } else {
          try {
            new URL(url);
          } catch {
            setFieldError(urlField, "Please enter a valid website address.");
            hasError = true;
          }
        }

        if (hasError) {
          if (msg) msg.textContent = "Please correct the highlighted fields.";
          return;
        }

        const payload = { name, email, url, notes, company };

        try {
          if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.textContent = "Running audit…";
          }

          if (msg) msg.textContent = "Running your audit…";

          const res = await fetch(form.action, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload)
          });

          const text = await res.text();
          let data = {};

          try {
            data = JSON.parse(text);
          } catch {
            throw new Error("Invalid JSON returned from server");
          }

          if (!res.ok || !data.ok) {
            throw new Error(data.error || `Request failed with status ${res.status}`);
          }

          if (data.redirect) {
            window.trackEcommonyEvent("audit_form_submit", {
              form_id: "contactForm",
              form_name: "Free audit form"
            });
            window.location.assign(data.redirect);
            return;
          }

          throw new Error("No redirect returned from server");
        } catch (err) {
          console.error("Audit handoff failed:", err);
          if (msg) msg.textContent = "Sorry — something failed. Please try again.";
        } finally {
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = "Get my free audit";
          }
        }
      });
    }
  </script>

  <script>
    const contactForm2 = document.getElementById("contactForm2");
    const contactMsg = document.getElementById("contactMsg");

    if (contactForm2) {
      let contactFormStarted = false;
      contactForm2.addEventListener("input", () => {
        if (!contactFormStarted) {
          contactFormStarted = true;
          window.trackEcommonyEvent("contact_form_start", {
            form_id: "contactForm2",
            form_name: "Contact form"
          });
        }
      }, { once: true });

      contactForm2.addEventListener("submit", async (e) => {
        e.preventDefault();
        contactMsg.textContent = "Sending…";

        const formData = new FormData(contactForm2);

        try {
          const res = await fetch(contactForm2.action, {
            method: "POST",
            body: JSON.stringify(Object.fromEntries(formData)),
            headers: { "Content-Type": "application/json" }
          });

          const data = await res.json();

          if (data.ok) {
            window.setTimeout(() => {
              window.trackEcommonyEvent("contact_form_submit", {
                form_id: "contactForm2",
                form_name: "Contact form"
              });
            }, 250);
            contactMsg.textContent = "Thanks — I’ll get back to you shortly.";
            contactForm2.reset();
          } else {
            throw new Error("Contact request failed");
          }
        } catch (err) {
          console.error(err);
          contactMsg.textContent = "Something went wrong. Please email directly.";
        }
      });
    }
  </script>
