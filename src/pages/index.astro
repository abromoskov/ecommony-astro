      },
      {
        "@type":"Service",
        "@id":"https://ecommony.com/#insight-engine",
        "name":"Ecommony Insight Engine",
        "provider":{"@id":"https://ecommony.com/#business"},
        "description":"A competitor-benchmarked website diagnosis covering speed, SEO, conversion performance and tracking confidence."
      },
      {
        "@type":"FAQPage",
        "@id":"https://ecommony.com/#faq-schema",
        "mainEntity":[
          {
            "@type":"Question",
            "name":"What does the free website diagnosis show?",
            "acceptedAnswer":{
              "@type":"Answer",
              "text":"It shows where your site is underperforming across speed, conversion, SEO and tracking accuracy, benchmarked against competitors and prioritised by likely commercial impact."
            }
          },
          {
            "@type":"Question",
            "name":"Who is this for?",
            "acceptedAnswer":{
              "@type":"Answer",
              "text":"It is designed for ecommerce and high-consideration websites on Shopify, Magento and WordPress that want to understand what technical drag is costing them before committing to implementation."
            }
          },
          {
            "@type":"Question",
            "name":"Why compare my site against competitors?",
            "acceptedAnswer":{
              "@type":"Answer",
              "text":"Because the real risk is not just that your site is imperfect. It is that a competitor is faster, clearer or better tracked and is taking market share while you are paying to acquire the same traffic."
            }
          },
          {
            "@type":"Question",
            "name":"What happens after the diagnosis?",
            "acceptedAnswer":{
              "@type":"Answer",
              "text":"You can use the report internally, or hire Ecommony for a deeper audit, implementation support, or ongoing technical growth consulting."
            }
          }
        ]
      }
    ]
  }
