        "name":"Ecommony",
        "url":"https://ecommony.com/",
        "description":"Technical ecommerce consulting for Shopify, Magento and WordPress focused on speed, conversion rate optimisation, technical SEO and GA4/GTM tracking accuracy.",
        "areaServed":"GB",
        "serviceType":[
          "Shopify speed optimisation consultant",
          "Magento technical ecommerce consultant",
          "WordPress technical SEO consultant",
          "GA4 and GTM ecommerce tracking consultant",
          "Conversion rate optimisation consultant"
